   "source": [
    "function chua_eq!(du,u,p,t)\n",
    "\n",
    "    R = p \n",
    "    \n",
    "    g = -1//22000*(9*u[1] +23//(3*2)*(log.(cosh.(20*(u[1].+3//23*18))) - log.(cosh.(20*(u[1].-3//23 * 18))))/20)\n",
    "\n",
    "\tdu[1] = 1e8*(1/R * (u[2]-u[1]) - g )\n",
    "\n",
    "\tdu[2] = 1e7*(1/R * (u[1]-u[2]) + u[3] )\n",
    "\n",
    "\tdu[3] = -(500//9)*u[2]\n",
    "    nothing\n",
    "end"
   ]
  },
